# ── Game content: never commit ─────────────────────────────────
# Disc images and extracted files belong to the user's own copy of the game.
game/
*.iso
*.xiso
*.xbe
*.bik

# Generated C is lifted from the game's executable, so it is a derivative of
# the game and is never committed. Regenerate it with scripts/regen.sh.
src/recomp/gen/

# ── Build output ───────────────────────────────────────────────
build/
build-*/
out/
bin/
*.o
*.obj
*.a
*.lib
*.exe
*.dll
*.pdb
*.ilk
*.exp
*.log
stderr*.txt

# ── Tooling ────────────────────────────────────────────────────
.venv/
__pycache__/
*.pyc

