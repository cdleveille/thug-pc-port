+enum { MMIO_X86_ALU_ADD = 0, MMIO_X86_ALU_OR = 1, MMIO_X86_ALU_AND = 4,
+       MMIO_X86_ALU_SUB = 5, MMIO_X86_ALU_XOR = 6, MMIO_X86_ALU_CMP = 7,
+       MMIO_X86_ALU_TEST = 8 };
+
+/* a OP b at the given width, with the flags a following jcc reads: ZF, SF, CF
+ * and OF, written into the saved RFLAGS so they are live when the thread
+ * resumes. PF and AF are left alone, as in mmio_decode.h; nothing branches on
+ * them after a register read. The logical operations clear CF and OF, as the
+ * hardware does. */
+static inline uint64_t mmio_x86_alu(mmio_ctx_t *uc, int op, uint64_t a,
+                                    uint64_t b, int size)
+{
+    uint64_t m = mmio_x86_size_mask(size), sign = 1ULL << (size * 8 - 1), r;
+    uint64_t efl;
+    int cf = 0, of = 0;
+
+    a &= m;
+    b &= m;
+    switch (op) {
+    case MMIO_X86_ALU_ADD:
+        r  = (a + b) & m;
+        cf = r < a;
+        of = ((~(a ^ b) & (a ^ r)) & sign) != 0;
+        break;
+    case MMIO_X86_ALU_SUB:
+    case MMIO_X86_ALU_CMP:
+        r  = (a - b) & m;
+        cf = a < b;
+        of = (((a ^ b) & (a ^ r)) & sign) != 0;
+        break;
+    case MMIO_X86_ALU_OR:  r = a | b; break;
+    case MMIO_X86_ALU_XOR: r = a ^ b; break;
+    default:               r = a & b; break;       /* AND, TEST */
+    }
