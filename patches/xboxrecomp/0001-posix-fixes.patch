+    efl &= ~(uint64_t)(0x0001u | 0x0040u | 0x0080u | 0x0800u);
+    if (cf)       efl |= 0x0001u;                   /* CF */
+    if (r == 0)   efl |= 0x0040u;                   /* ZF */
+    if (r & sign) efl |= 0x0080u;                   /* SF */
+    if (of)       efl |= 0x0800u;                   /* OF */
+    memcpy(&uc->uc_mcontext.gregs[REG_EFL], &efl, sizeof efl);
