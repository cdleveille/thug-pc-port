+void apu_apply_gain(int16_t *samples, int n, float g0, float g1)
+{
+    float step = n > 1 ? (g1 - g0) / (float)n : 0.0f, g = g0;
+    for (int i = 0; i < n; i++, g += step) {
+        float v = (float)samples[i] * g;
+        v += v < 0.0f ? -0.5f : 0.5f;
+        samples[i] = (int16_t)(v > 32767.0f ? 32767.0f : v < -32768.0f ? -32768.0f : v);
+    }
