+        return;
+    case 3:
+        for (j = 0; j < 4; j++) for (l = 0; l < VB; l++) r->c[j][l] = a->c[j][l] + c->c[j][l];
+        return;
+    case 4:
+        for (j = 0; j < 4; j++) for (l = 0; l < VB; l++)
+            r->c[j][l] = a->c[j][l] * b->c[j][l] + c->c[j][l];
+        return;
+    case 5:
+        for (l = 0; l < VB; l++)
+            t[l] = a->c[0][l]*b->c[0][l] + a->c[1][l]*b->c[1][l] + a->c[2][l]*b->c[2][l];
+        splat_b(r, t);
+        return;
+    case 6:
+        for (l = 0; l < VB; l++)
+            t[l] = a->c[0][l]*b->c[0][l] + a->c[1][l]*b->c[1][l] + a->c[2][l]*b->c[2][l]
+                 + b->c[3][l];
+        splat_b(r, t);
+        return;
+    case 7:
+        for (l = 0; l < VB; l++)
+            t[l] = a->c[0][l]*b->c[0][l] + a->c[1][l]*b->c[1][l] + a->c[2][l]*b->c[2][l]
+                 + a->c[3][l]*b->c[3][l];
+        splat_b(r, t);
+        return;
+    case 8:
+        for (l = 0; l < VB; l++) {
+            r->c[0][l] = 1.0f;
+            r->c[1][l] = a->c[1][l] * b->c[1][l];
+            r->c[2][l] = a->c[2][l];
+            r->c[3][l] = b->c[3][l];
+        }
+        return;
+    case 9:
+        for (j = 0; j < 4; j++) for (l = 0; l < VB; l++)
+            r->c[j][l] = a->c[j][l] < b->c[j][l] ? a->c[j][l] : b->c[j][l];
+        return;
+    case 10:
+        for (j = 0; j < 4; j++) for (l = 0; l < VB; l++)
+            r->c[j][l] = a->c[j][l] >= b->c[j][l] ? a->c[j][l] : b->c[j][l];
+        return;
+    case 11:
+        for (j = 0; j < 4; j++) for (l = 0; l < VB; l++)
+            r->c[j][l] = a->c[j][l] < b->c[j][l] ? 1.0f : 0.0f;
+        return;
+    case 12:
+        for (j = 0; j < 4; j++) for (l = 0; l < VB; l++)
+            r->c[j][l] = a->c[j][l] >= b->c[j][l] ? 1.0f : 0.0f;
+        return;
+    case 13:
+        for (l = 0; l < n; l++)
+            a0[l] = (int)floorf(a->c[0][l] + 0.001f);
+        *r = *a;
+        return;
+    default:                                    /* mov, and anything unknown */
+        *r = *a;
+        return;
+    }
+}
+
+static void run_ilu_b(uint32_t op, const vec4b *c, vec4b *r, int n)
+{
+    float t[VB];
+    int l;
+
+    switch (op) {
+    case 2:
+        for (l = 0; l < VB; l++) {
+            float x = c->c[0][l];
+            t[l] = x == 0.0f ? INFINITY : 1.0f / x;
+        }
+        splat_b(r, t);
+        return;
+    case 3:
+        for (l = 0; l < VB; l++) {
+            float f = 1.0f / c->c[0][l];
+            if (fabsf(f) < 5.42101e-20f) f = f < 0 ? -5.42101e-20f : 5.42101e-20f;
+            if (fabsf(f) > 1.884467e19f) f = f < 0 ? -1.884467e19f : 1.884467e19f;
+            t[l] = f;
+        }
+        splat_b(r, t);
+        return;
+    case 4:
+        for (l = 0; l < VB; l++)
+            t[l] = 1.0f / sqrtf(fabsf(c->c[0][l]));
+        splat_b(r, t);
+        return;
+    case 5:
+        for (l = 0; l < n; l++) {
+            float x = c->c[0][l], fl = floorf(x);
+            r->c[0][l] = exp2f(fl); r->c[1][l] = x - fl;
+            r->c[2][l] = exp2f(x); r->c[3][l] = 1.0f;
+        }
+        return;
+    case 6:
+        for (l = 0; l < n; l++) {
+            float ax = fabsf(c->c[0][l]);
+            if (ax == 0.0f) {
+                r->c[0][l] = r->c[2][l] = -INFINITY; r->c[1][l] = 1.0f;
+            } else {
+                float e = floorf(log2f(ax));
+                r->c[0][l] = e; r->c[1][l] = ax / exp2f(e); r->c[2][l] = log2f(ax);
+            }
+            r->c[3][l] = 1.0f;
+        }
+        return;
+    case 7:
+        for (l = 0; l < n; l++) {
+            float x = c->c[0][l], y = c->c[1][l], w = c->c[3][l];
+            float nl = x > 0.0f ? x : 0.0f;
+            float nh = y > 0.0f ? y : 0.0f;
+            float p = w < -127.9961f ? -127.9961f : (w > 127.9961f ? 127.9961f : w);
+            r->c[0][l] = 1.0f; r->c[1][l] = nl;
+            r->c[2][l] = x > 0.0f ? powf(nh, p) : 0.0f; r->c[3][l] = 1.0f;
+        }
+        return;
+    default:                                    /* mov */
+        *r = *c;
+        return;
+    }
+}
+
+int nv2a_vsh_run_batch(const float (*in)[NV2A_VSH_INPUTS][4],
+                       Nv2aVshOutput *out, int n)
+{
+    static int check = -1;
+    vec4b regs[13], outregs[13];          /* regs: R0..R11, then oPos */
+    vec4b a, b, c, mres, ires;
+    int a0[VB];
+    uint32_t i;
+    int l, k;
+
+    if (n <= 0)
+        return 1;
+    if (n > VB || !nv2a_vsh_batch_ok()) {
+        for (l = 0; l < n; l++)
+            if (!nv2a_vsh_run(in[l], &out[l]))
+                return 0;
+        return 1;
+    }
+    memset(regs, 0, sizeof regs);
+    memset(outregs, 0, sizeof outregs);
+    memset(a0, 0, sizeof a0);
+    for (l = 0; l < VB; l++) {
+        outregs[3].c[3][l] = outregs[4].c[3][l] = 1.0f;
+        outregs[9].c[3][l] = outregs[10].c[3][l] = 1.0f;
+        outregs[11].c[3][l] = outregs[12].c[3][l] = 1.0f;
+    }
+    memset(&a, 0, sizeof a);
+    b = c = a;
+    for (i = 0; i < s_dec_count; i++) {
+        const DecIns *d = &s_dec[i];
+
+        if (d->reads & 1) dec_read_b(&d->src[0], in, regs, a0, n, &a);
+        if (d->reads & 2) dec_read_b(&d->src[1], in, regs, a0, n, &b);
+        if (d->reads & 4) dec_read_b(&d->src[2], in, regs, a0, n, &c);
+        /* As vsh_run_decoded: an absent op's result reads as zero. */
+        if (d->mac)
+            run_mac_b(d->mac, &a, &b, &c, &mres, a0, n);
+        else
+            memset(&mres, 0, sizeof mres);
+        if (d->ilu)
+            run_ilu_b(d->ilu, &c, &ires, n);
+        else
+            memset(&ires, 0, sizeof ires);
+        if (d->mac_mask && d->mac_dst != DEC_NO_DST)
+            write_masked_b(&regs[d->mac_dst], &mres, d->mac_mask);
+        if (d->ilu_mask && d->ilu_dst != DEC_NO_DST)
+            write_masked_b(&regs[d->ilu_dst], &ires, d->ilu_mask);
+        if (d->omask && d->to_o) {
+            const vec4b *src = d->from_ilu ? &ires : &mres;
+            if (d->oaddr == 0)
+                write_masked_b(&regs[12], src, d->omask);
+            else if (d->oaddr < 13)
+                write_masked_b(&outregs[d->oaddr], src, d->omask);
+        }
+        if (d->final)
+            break;
+    }
+    if (i == s_dec_count)
+        return 0;                            /* no FINAL: as vsh_run_decoded */
+    for (l = 0; l < n; l++) {
+        Nv2aVshOutput *o = &out[l];
+        for (k = 0; k < 4; k++) {
+            float c0 = outregs[3].c[k][l], c1 = outregs[4].c[k][l];
+            o->pos[k] = regs[12].c[k][l];
+            o->d0[k] = c0 > 1.0f ? 1.0f : (c0 >= 0.0f ? c0 : 0.0f);
+            o->d1[k] = c1 > 1.0f ? 1.0f : (c1 >= 0.0f ? c1 : 0.0f);
+            o->fog[k] = outregs[5].c[k][l];
+            o->tex[0][k] = outregs[9].c[k][l];
+            o->tex[1][k] = outregs[10].c[k][l];
+            o->tex[2][k] = outregs[11].c[k][l];
+            o->tex[3][k] = outregs[12].c[k][l];
+        }
+    }
+    if (check < 0)
+        check = getenv("RECOMP_VSH_BATCH_CHECK") != NULL;
+    if (check) {
+        static unsigned told;
+        static unsigned long long checked;
+        for (l = 0; l < n; l++) {
+            Nv2aVshOutput ref;
+            checked++;
+            if (vsh_run_decoded(in[l], &ref) && memcmp(&ref, &out[l], sizeof ref) != 0
+                    && told++ < 16)
+                fprintf(stderr, "[VSH-BATCH] lane %d differs: pos %g %g %g %g vs"
+                        " %g %g %g %g (after %llu vertices)\n", l, ref.pos[0],
+                        ref.pos[1], ref.pos[2], ref.pos[3], out[l].pos[0],
+                        out[l].pos[1], out[l].pos[2], out[l].pos[3], checked);
+        }
+    }
+    return 1;
+}
+
+/* Instructions in the decoded program (diagnostics). */
+int nv2a_vsh_program_length(void)
+{
+    return s_dec_valid ? (int)s_dec_count : 0;
+}
