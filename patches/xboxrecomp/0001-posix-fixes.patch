+/* The submitted commands from `from` up to PUT, in the order the DMA engine
+ * reads them: a JUMP is followed (the ring's wrap is a JUMP back to its start,
+ * and its target is the real start, wherever this lap's JUMP was put), a CALL
+ * runs its subroutine, and the walk ends exactly at PUT. Returns where it
+ * stopped: PUT, or the header of a method whose parameters are not all
+ * written yet (D3D streams long inline arrays across kicks), which the next
+ * walk then reads whole. Physical addresses, as DMA_PUT holds them.
+ *
+ * This replaces the segment scan's guess at the wrap. That scan read from the
+ * last PUT to the highest PUT ever seen and then from the lowest PUT ever seen
+ * to the new one; when this lap's JUMP or its target differed from those, a
+ * wrap either dropped the first commands after it or replayed stale ones from
+ * an earlier lap. In Tony Hawk's Underground that was a one-frame glitch at
+ * every wrap: a mesh drawn with the previous mesh's vertex arrays (D3D had
+ * set its own in the dropped commands), or a whole extra frame drawn. */
+uint32_t nv2a_pb_scan_to_put(uint32_t from_phys, uint32_t put_phys)
+{
+    const uint8_t *mem = (const uint8_t *)xbox_GetMemoryOffset();
+    uint32_t va = from_phys & PB_PHYS_MASK, put = put_phys & PB_PHYS_MASK;
+    uint32_t words = 0, jumps = 0, unknown = 0, dummy = 0;
+
+    /* No progress is reported mid-walk (kickoff acknowledged, GET moved):
+     * with a mirrored fence that lets XDK D3D see a GPU "far behind" a fence
+     * and take its software-method wake-up path, which hangs without the
+     * GPU interrupt; and ticking the mirror mid-walk lets it overwrite
+     * commands not read yet. The title waits in its kickoff until the walk
+     * ends, as it always has. */
+    extern int nv2a_pb_exec_prof_on(void);
+    extern void nv2a_pb_exec_prof_walk(uint64_t ns);
+    struct timespec ts0, ts1;
+    int prof;
+
+    if (!pb_walk_enabled())
+        return put;
+    prof = s_exec_enabled && nv2a_pb_exec_prof_on();
+    if (prof)
+        clock_gettime(CLOCK_MONOTONIC, &ts0);
+    if (s_exec_enabled) {
+        extern void nv2a_pb_exec_walk_begin(void);
+        nv2a_pb_exec_walk_begin();      /* the flip hold's vblank */
+    }
+    while (va != put) {
+        uint32_t at = va, w;
+
+        if (va >= PB_RAM_BYTES || ++words > 0x400000u || unknown > 64 || jumps > 16) {
+            va = put;                   /* lost: snap to PUT, as the walk does */
+            break;
+        }
+        w = *(const uint32_t *)(mem + (0x80000000u | va));
+        s_hist[s_hist_n % PB_HIST].at = at;
+        s_hist[s_hist_n % PB_HIST].w = w;
+        s_hist_n++;
+        va = (va + 4) & PB_PHYS_MASK;
+
+        if ((w & 0xE0000003u) == 0x20000000u || (w & 3u) == 1u) {   /* jump */
+            uint32_t target = (w & 3u) == 1u ? (w & 0xFFFFFFFCu) : (w & 0x1FFFFFFCu);
+            if (pb_bad_target(w, at, target, put)) { va = put; break; }
+            pb_flow(at, w, target);
+            va = target & PB_PHYS_MASK;
+            jumps++;
+            continue;
+        }
+        if ((w & 3u) == 2u) {                                         /* call */
+            uint32_t sub = 0x80000000u | ((w & 0xFFFFFFFCu) & 0x0FFFFFFFu);
