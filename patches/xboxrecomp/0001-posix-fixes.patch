+/* A voice list named a handle the hardware cannot have. Rate-limited: one
+ * line at 1, 10, 100... occurrences, which is enough to tell a one-off torn
+ * read from a list that is wrong every frame. */
+static void vp_bad_handle_report(int list, uint32_t v)
+{
+    static uint64_t count;
+    uint64_t n = ++count;
+
+    while (n >= 10 && n % 10 == 0)
+        n /= 10;
+    if (n != 1)
+        return;
+    fprintf(stderr, "[APU] voice list %d names handle 0x%04X (only 0..%d or "
+                    "0xFFFF are valid); list ended there, %llu time(s)\n",
+            list, (unsigned)v, MCPX_HW_MAX_VOICES - 1,
+            (unsigned long long)count);
+    fflush(stderr);
+}
