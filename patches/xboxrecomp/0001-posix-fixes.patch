index 9476517..bd07494 100644
--- a/src/kernel/kernel_bridge.c
+++ b/src/kernel/kernel_bridge.c
@@ -2344,11 +2344,35 @@ static void bridge_KeDelayExecutionThread(void)
  * failure surfaced later somewhere unrelated. Report the code and stop
  * pretending the call succeeded.
  */
+/*
+ * And then stop. A bug check never returns on the console, and code written
+ * against it relies on that: the MSVC CRT's exit() ends in _doexit ->
+ * KeBugCheck and its callers leave exit()'s argument on the stack, so a
+ * bug check that returns resumes the title four bytes off its own frame.
+ * Tony Hawk's Underground reached exit() when a texture failed to allocate;
+ * returning turned that into a texture-copy loop reading its pointers as its
+ * bound, spinning for good on the level's loading screen, with this one line
+ * the only sign. RECOMP_BUGCHECK_CONTINUE=1 restores the old behaviour.
+ */
+static void bridge_bugcheck_halt(void)
+{
+    if (getenv("RECOMP_BUGCHECK_CONTINUE"))
+        return;
+    fprintf(stderr, "  [KERNEL] the console halts at a bug check; exiting "
+                    "(RECOMP_BUGCHECK_CONTINUE=1 carries on instead)\n");
+    xbox_PeekSample("bugcheck peek");
+    RECOMP_ICALL_FEEDBACK_DUMP();
+    xbox_missing_summary("bugcheck");
+    fflush(stderr);
+    ExitProcess(3);
+}
+
 static void bridge_KeBugCheck(void)
 {
     fprintf(stderr, "  [KERNEL] *** KeBugCheck: code=0x%08X ***\n",
             STACK_ARG(0));
     fflush(stderr);
+    bridge_bugcheck_halt();
     g_eax = 0;
 }
 
@@ -2359,6 +2383,7 @@ static void bridge_KeBugCheckEx(void)
             STACK_ARG(0), STACK_ARG(1), STACK_ARG(2),
             STACK_ARG(3), STACK_ARG(4));
     fflush(stderr);
+    bridge_bugcheck_halt();
     g_eax = 0;
 }
 
